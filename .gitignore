# =========================================================
# SistemaParroquialUI - .gitignore raíz
# Cubre backend (Django/Python) y frontend (React/Vite)
# =========================================================

# --- Python / Django (backend) ---
backend/venv/
backend/env/
backend/.venv/
**/__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
*.sqlite3
backend/staticfiles/
backend/.pytest_cache/
.env
backend/.env

# --- Datos sensibles / generados (backend) ---
# Dumps de base de datos: NUNCA deben versionarse (datos reales de feligreses).
backend/Backups/
*.sql
*.backup

# PDFs generados por usuario (output), no plantillas:
backend/media/documentos/*.pdf

# Imágenes de debug del módulo scanner (OCR):
backend/debug_*.jpg

# NOTA: backend/media/certificados/assets/*.png y
# backend/media/certificados/templates/*.json SÍ se versionan:
# son plantillas de entrada que usa certificados.py, no output generado.


# --- Node / React / Vite (frontend) ---
**/node_modules/
frontend/dist/
frontend/build/
frontend/.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Editores / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Claude Code ---
.claude/local/
.claude/*.log
